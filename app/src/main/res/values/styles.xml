<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/tabbar_bg</item>
        <item name="android:navigationBarColor">@color/tabbar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nav_item_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

</resources>
