<?xml version="1.0" encoding="utf-8"?>
<!--
  thonly.cc 首页目前 302 跳到 http:// 明文地址，WebView 默认会拦截。
  这里只给这一个域名放行明文，其它域名一律禁止。
  更彻底的做法是把服务端跳转改成 https，然后把这个文件也删掉。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">thonly.cc</domain>
    </domain-config>
</network-security-config>
